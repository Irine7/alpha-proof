generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Signal {
  id             Int      @id @default(autoincrement())
  chainSignalId  Int?
  signalType     String
  asset          String
  wallet         String?
  pool           String?
  marketDataMode String   @default("demo")
  sourceChain    String?
  sourceTxHash   String?
  sourceBlockNumber String?
  sourceWallet   String?
  sourceProtocol String?
  sourcePool     String?
  counterAsset   String?
  usdValue       Float?
  sourceEventType String?
  detectedAt     DateTime?
  rawEventJson   String?
  confidence     Int
  prediction     Int
  aiSummary      String
  reasoning      String
  sourceDataJson String
  reasoningHash  String
  dataHash       String
  status         String   @default("Pending")
  outcome        String   @default("Unknown")
  commitTxHash   String?
  commitBlockNumber String?
  committedAt    DateTime?
  contractAddress String?
  resolveTxHash  String?
  createdAt      DateTime @default(now())
  evaluationTime DateTime
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([outcome])
  @@index([signalType])
  @@index([marketDataMode])
  @@index([sourceEventType])
}
