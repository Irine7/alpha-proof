DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"
PORT=4000

# Proof network: local | testnet | mainnet | mock
# testnet defaults to Mantle Sepolia Testnet (chainId 5003)
CHAIN_MODE="local"

# Market source: demo | historical_mainnet | live_mainnet
MARKET_DATA_MODE="historical_mainnet"

SIGNAL_REGISTRY_ADDRESS=""

# Local proof RPC. MANTLE_RPC_URL is a legacy alias; prefer MANTLE_LOCAL_RPC_URL.
MANTLE_LOCAL_RPC_URL="http://127.0.0.1:8545"
MANTLE_RPC_URL=""

# Mantle Sepolia Testnet proof network.
MANTLE_TESTNET_RPC_URL="https://rpc.sepolia.mantle.xyz"
MANTLE_TESTNET_EXPLORER_URL="https://explorer.sepolia.mantle.xyz"
EXPECTED_CHAIN_ID=5003

# Mantle Mainnet options for future/live modes.
MANTLE_MAINNET_RPC_URL="https://rpc.mantle.xyz"
MANTLE_MAINNET_EXPLORER_URL="https://explorer.mantle.xyz"

# Legacy generic explorer fallback. Current testnet links use MANTLE_TESTNET_EXPLORER_URL.
MANTLE_EXPLORER_URL="https://explorer.sepolia.mantle.xyz"

# Live mainnet reader options. TRACKED_TOKEN_ADDRESSES is comma-separated.
LIVE_SCAN_BLOCK_WINDOW=100
LIVE_TRANSFER_THRESHOLD_UNITS="100000"
TRACKED_TOKEN_ADDRESSES=""

# Backend agent wallet used for commit/resolve transactions.
# Do not use PRIVATE_KEY here; PRIVATE_KEY belongs to contracts/.env for Hardhat deploys.
AGENT_PRIVATE_KEY=""

TELEGRAM_ENABLED=false
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_ALERTS=false
TELEGRAM_ALERTS_ON_CREATE=true
TELEGRAM_ALERTS_ON_RESOLVE=true
TELEGRAM_ALERTS_FOR_BULK=false
TELEGRAM_ALLOW_DEMO_COMMAND=false
TELEGRAM_ALLOWED_DEMO_CHAT_IDS=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH=/api/telegram/webhook
PUBLIC_APP_URL=http://localhost:3000
# For demo video/submission:
# PUBLIC_APP_URL=https://your-public-frontend-url

AI_PROVIDER="mock"
OPENAI_API_KEY=""

# Optional one-off script flags. Prefer CLI args where available.
SIGNAL_ID=
RESOLVE_AFTER_CREATE=false
DEMO_RESOLVE_AFTER_CREATE=false
RESOLVE_ALL=false
CONFIRM_RESOLVE_ALL=
DEMO_REPUTATION_PROFILE=default
CONFIRM_DEV_CLEAN_SIGNALS=
