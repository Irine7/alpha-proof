{
  "name": "alphaproof-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Verifiable AI alpha agent for Mantle Network hackathon MVP.",
  "scripts": {
    "dev": "pnpm --parallel --filter @alphaproof/backend --filter @alphaproof/frontend dev",
    "build": "pnpm --recursive build",
    "check": "pnpm --recursive check",
    "contracts:test": "pnpm --filter @alphaproof/contracts test",
    "contracts:deploy": "pnpm --filter @alphaproof/contracts deploy",
    "contracts:deploy:local": "pnpm --filter @alphaproof/contracts deploy:local",
    "contracts:read:local": "pnpm --filter @alphaproof/contracts read:local",
    "backend:db": "pnpm --filter @alphaproof/backend db:push",
    "proof:smoke": "pnpm --filter @alphaproof/backend proof:smoke",
    "proof:smoke:testnet": "pnpm --filter @alphaproof/backend proof:smoke:testnet",
    "proof:create-pending:testnet": "pnpm --filter @alphaproof/backend proof:create-pending:testnet",
    "proof:resolve": "pnpm --filter @alphaproof/backend proof:resolve",
    "proof:resolve-latest": "pnpm --filter @alphaproof/backend proof:resolve-latest",
    "proof:resolve-all": "pnpm --filter @alphaproof/backend proof:resolve-all",
    "proof:seed-curated": "pnpm --filter @alphaproof/backend proof:seed-curated",
    "telegram:test": "pnpm --filter @alphaproof/backend telegram:test",
    "telegram:test:reputation": "pnpm --filter @alphaproof/backend telegram:test:reputation",
    "telegram:test-subscription": "pnpm --filter @alphaproof/backend telegram:test-subscription",
    "telegram:demo-flow": "pnpm --filter @alphaproof/backend telegram:demo-flow",
    "telegram:set-webhook": "pnpm --filter @alphaproof/backend telegram:set-webhook",
    "telegram:delete-webhook": "pnpm --filter @alphaproof/backend telegram:delete-webhook",
    "telegram:webhook-info": "pnpm --filter @alphaproof/backend telegram:webhook-info"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
